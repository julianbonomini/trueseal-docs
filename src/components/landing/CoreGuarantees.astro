---
import SectionHeader from './SectionHeader.astro';
import GuaranteeCard from './GuaranteeCard.astro';

const guarantees = [
  {
    number: '01',
    title: 'Zero Trust',
    icon: 'vpn_key',
    description:
      'Data is encrypted on device before it moves anywhere. The relay receives ciphertext and has no keys. An adversary who fully compromises the relay gains nothing but encrypted blobs.',
  },
  {
    number: '02',
    title: 'Anonymity',
    icon: 'visibility_off',
    description:
      'No accounts, no registration, no human identity. A device is a keypair. Push sessions use fresh ephemeral keys — the relay cannot link a push to any device or construct a communication graph.',
  },
  {
    number: '03',
    title: 'No Lock-In',
    icon: 'lock_open',
    description:
      'Any deployed relay instance works. Run your own on any server or use a public instance. The security model is identical regardless of who operates the relay.',
  },
];
---

<section class="core-guarantees">
  <div class="core-guarantees__inner">
    <SectionHeader title="Core Guarantees" subtitle="SYSTEM_CONSTRAINTS" />

    <div class="core-guarantees__grid">
      {guarantees.map(g => <GuaranteeCard {...g} />)}
    </div>
  </div>
</section>

<style>
  .core-guarantees {
    width: 100%;
    border-top: 1px solid var(--color-primary);
  }

  .core-guarantees__inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: calc(var(--space-xl) * 2) var(--space-xl);
  }

  .core-guarantees__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--color-primary);
    border: 1px solid var(--color-primary);
  }

  @media (min-width: 768px) {
    .core-guarantees__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
