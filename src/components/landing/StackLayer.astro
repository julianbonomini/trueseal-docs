---
interface Props {
  layer: string;
  name: string;
  description: string;
  href: string;
  active?: boolean;
  isSpec?: boolean;
}

const { layer, name, description, href, active = false, isSpec = false } = Astro.props;
---

<div class:list={['stack-layer', { 'stack-layer--active': active, 'stack-layer--spec': isSpec }]}>
  <div class="stack-layer__id">
    <span class="stack-layer__layer">{layer}</span>
    <span class="stack-layer__name">{name}</span>
  </div>

  <div class="stack-layer__desc">
    <p>{description}</p>
  </div>

  <div class="stack-layer__action">
    <a href={href} class="stack-layer__link">
      VIEW SPEC
    </a>
  </div>
</div>

<style>
  .stack-layer {
    padding: var(--space-xl) clamp(16px, 5vw, var(--space-xl));
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .stack-layer {
      flex-direction: row;
      align-items: center;
    }
  }

  .stack-layer__id {
    width: 100%;
    font-family: var(--font-mono);
    font-size: var(--text-code);
  }

  @media (min-width: 768px) {
    .stack-layer__id { width: 25%; }
  }

  .stack-layer__layer {
    display: block;
    color: var(--ink-muted);
    margin-bottom: var(--space-xs);
  }

  .stack-layer__name {
    display: block;
    font-size: 16px;
    font-weight: 600;
  }

  .stack-layer__desc {
    width: 100%;
  }

  @media (min-width: 768px) {
    .stack-layer__desc { width: 50%; }
  }

  .stack-layer__desc p {
    font-size: var(--text-ui);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .stack-layer__action {
    width: 100%;
    display: flex;
    justify-content: flex-start;
  }

  @media (min-width: 768px) {
    .stack-layer__action {
      width: 25%;
      justify-content: flex-end;
    }
  }

  .stack-layer__link {
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }

  .stack-layer--spec .stack-layer__name,
  .stack-layer--spec .stack-layer__link {
    color: var(--ink-muted);
  }
</style>
