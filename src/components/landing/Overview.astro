---
// The Overview part of the Journey: why private sync gets dropped, what TrueSeal takes on, and how it compares.
import LandingSection from './LandingSection.astro';

interface ComparisonRow {
  feature: string;
  libsodium: string;
  cloudKit: string;
  trueSeal: string;
}

// Every cell has a dated primary source in brand/91_EVIDENCE.md. Change a cell there first.
const rows: ComparisonRow[] = [
  {
    feature: 'Server can read the data',
    libsodium: 'No',
    cloudKit: 'Not those fields, if the user turned on Advanced Data Protection',
    trueSeal: 'No',
  },
  {
    feature: 'Pairing and membership',
    libsodium: 'You build it',
    cloudKit: 'iCloud sharing, an iCloud account each',
    trueSeal: 'Included',
  },
  { feature: 'Offline outbox', libsodium: 'You build it', cloudKit: 'Included, with CKSyncEngine', trueSeal: 'Included' },
  { feature: 'Platforms', libsodium: 'Any', cloudKit: 'Apple platforms', trueSeal: 'Swift, Kotlin, TypeScript' },
  { feature: 'Runs on your own server', libsodium: 'Yes, you write the server', cloudKit: 'No', trueSeal: 'Yes' },
  {
    feature: 'Ready for production',
    libsodium: 'The library is stable. Your protocol is yours to judge.',
    cloudKit: 'Yes',
    trueSeal: "Not yet. It's a preview.",
  },
];
---

<LandingSection
  id="overview"
  heading="Private sync usually turns into a protocol project."
  docs={{ href: '/docs/overview/what-trueseal-is', label: 'Read the overview' }}
>
  <Fragment slot="aside">
    <p>
      You're building an app where a few devices share something personal, like a family's locations, passwords
      between your own laptops or a clipboard. Making that private means pairing, key sharing, an offline outbox and
      membership, so most apps ship it readable by whoever runs the server.
    </p>
    <p>TrueSeal does those parts for you. Your data model, your conflict rules and your pairing screens stay yours.</p>
  </Fragment>

  <div slot="wide" class="compare" role="region" aria-label="TrueSeal compared with the alternatives" tabindex="0">
    <table class="compare__table">
      <thead>
        <tr>
          <th scope="col"><span class="visually-hidden">Feature</span></th>
          <th scope="col">libsodium and your own pairing</th>
          <th scope="col">CloudKit encrypted fields</th>
          <th scope="col" class="compare__us">TrueSeal</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map(row => (
            <tr>
              <th scope="row">{row.feature}</th>
              <td>{row.libsodium}</td>
              <td>{row.cloudKit}</td>
              <td class="compare__us">{row.trueSeal}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</LandingSection>

<style>
  .compare {
    overflow-x: auto;
  }

  .compare__table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 15px;
  }

  .compare__table th,
  .compare__table td {
    text-align: left;
    padding: 15px 16px;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }

  .compare__table thead th {
    font-weight: 500;
    color: var(--ink-muted);
    border-bottom-color: var(--ink);
  }

  .compare__table tbody th {
    font-weight: 500;
  }

  .compare__table td {
    color: var(--ink-muted);
  }

  .compare__table .compare__us {
    color: var(--ink);
    font-weight: 600;
    border-left: 1px solid var(--ink);
    border-right: 1px solid var(--ink);
  }

  .compare__table thead .compare__us {
    border-top: 1px solid var(--ink);
  }

  .compare__table tbody tr:last-child .compare__us {
    border-bottom: 1px solid var(--ink);
  }
</style>
