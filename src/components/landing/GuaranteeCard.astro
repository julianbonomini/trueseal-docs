---
interface Props {
  number: string;
  title: string;
  description: string;
  icon: string;
}

const { number, title, description, icon } = Astro.props;
---

<div class="guarantee-card">
  <div class="guarantee-card__indicator" />
  <div class="guarantee-card__icon">
    <span class="material-symbols-outlined">{icon}</span>
  </div>

  <h3 class="guarantee-card__title">{number} // {title}</h3>

  <p class="guarantee-card__desc">{description}</p>
</div>

<style>
  .guarantee-card {
    background: var(--color-surface);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    transition: background 0.1s;
  }

  .guarantee-card:hover {
    background: var(--color-surface-container-lowest);
  }

  .guarantee-card__indicator {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-primary);
    opacity: 0;
    transition: opacity 0.15s;
  }

  .guarantee-card:hover .guarantee-card__indicator {
    opacity: 1;
  }

  .guarantee-card__icon {
    width: 48px;
    height: 48px;
    border: 1px solid var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-lg);
    background: var(--color-surface-container-lowest);
    flex-shrink: 0;
  }

  .guarantee-card__icon .material-symbols-outlined {
    font-size: 24px;
    color: var(--color-on-surface);
  }

  .guarantee-card__title {
    font-family: var(--font-mono);
    font-size: var(--text-mono-code-size);
    font-weight: 700;
    color: var(--color-on-surface);
    text-transform: uppercase;
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-surface-variant);
  }

  .guarantee-card__desc {
    font-family: var(--font-sans);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-leading);
    color: var(--color-on-surface-variant);
    flex: 1;
    margin: 0;
  }
</style>
