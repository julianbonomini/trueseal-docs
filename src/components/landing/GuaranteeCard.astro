---
interface Props {
  number: string;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<div class="guarantee-card">
  <h3 class="guarantee-card__title">{number} // {title}</h3>

  <p class="guarantee-card__desc">{description}</p>
</div>

<style>
  .guarantee-card {
    padding: var(--space-xl) clamp(16px, 5vw, var(--space-xl));
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .guarantee-card__title {
    font-family: var(--font-mono);
    font-size: var(--text-code);
    font-weight: 600;
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--rule);
  }

  .guarantee-card__desc {
    font-size: var(--text-ui);
    line-height: 1.6;
    color: var(--ink-muted);
    flex: 1;
  }
</style>
