---
---

<div class="hero-visual tech-grid">
  <div class="hero-visual__inner">
    <div class="hero-visual__meta">
      <span>ZERO_TRUST</span>
      <span>ANNONIMITY</span>
    </div>
    <div class="hero-visual__icon">
      <span class="material-symbols-outlined">enhanced_encryption</span>
    </div>
    <div class="hero-visual__meta">
      <span>GUARANTEED_DELIVERY</span>
      <span>NO_LOCK_IN</span>
    </div>
  </div>
</div>

<style>
  .hero-visual {
    border: 1px solid var(--color-primary);
    background-color: var(--color-surface-container-lowest);
    min-height: 300px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md);
  }

  .hero-visual__inner {
    width: 100%;
    height: 100%;
    border: 1px solid var(--color-primary);
    padding: var(--space-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--color-surface);
    min-height: 280px;
  }

  .hero-visual__meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-secondary);
    letter-spacing: var(--text-mono-label-tracking);
  }

  .hero-visual__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
  }

  .hero-visual__icon .material-symbols-outlined {
    font-size: 120px;
    color: var(--color-primary);
    opacity: 0.15;
    font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 48;
  }
</style>
