---
// The empty frame of the Seal Demo: three panes, no behaviour.
// TODO: the 03-seal-demo Ticket replaces this frame with the Seal Demo Island.
const panes = [
  { title: "Mum's phone", relay: false },
  { title: 'The relay', relay: true },
  { title: 'Your phone', relay: false },
];
---

<figure class="seal-demo-placeholder" aria-label="Seal Demo">
  {
    panes.map(pane => (
      <div class="seal-demo-placeholder__pane">
        <p class="seal-demo-placeholder__title">{pane.title}</p>
        <div class:list={['seal-demo-placeholder__area', { 'seal-demo-placeholder__area--relay': pane.relay }]}>
          {pane.relay && <p class="seal-demo-placeholder__empty">Sealed packets appear here.</p>}
        </div>
      </div>
    ))
  }
</figure>

<style>
  .seal-demo-placeholder {
    border: 1px solid var(--ink);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .seal-demo-placeholder__pane {
    padding: 20px;
    min-width: 0;
  }

  .seal-demo-placeholder__pane + .seal-demo-placeholder__pane {
    border-top: 1px solid var(--ink);
  }

  @media (min-width: 900px) {
    .seal-demo-placeholder {
      grid-template-columns: 1fr 1.15fr 1fr;
    }

    .seal-demo-placeholder__pane + .seal-demo-placeholder__pane {
      border-top: 0;
      border-left: 1px solid var(--ink);
    }
  }

  .seal-demo-placeholder__title {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 14px;
  }

  .seal-demo-placeholder__area {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--rule);
    display: grid;
    place-items: center;
  }

  .seal-demo-placeholder__area--relay {
    background: var(--wash);
  }

  .seal-demo-placeholder__empty {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-muted);
  }
</style>
