---
// The Integrate part of the Journey: the integration in each SDK's language, and the Agent Snippet.
import LandingSection from './LandingSection.astro';
import CodeTabs, { type CodeTab } from './CodeTabs.astro';
import { agentSnippet } from '../../agent-snippet/agent-snippet';

// The current canonical SDK API (trueseal-sync ADR-0028; package names ADR-0030), with the accept
// step written out. Verified symbol-for-symbol against the SDK repos on 2026-10-14 — Swift at
// 1480349, Kotlin at c7baeca, TypeScript at db88816 (brand/91_EVIDENCE.md). Line counts in the
// copy below follow the section-10 counting rule: every line except blanks and comment-only
// lines; imports count; app code the snippet calls (store, repository, db, location,
// scannedToken, scope, context) needs no definition.
const snippets: CodeTab[] = [
  {
    label: 'Swift',
    code: `// Package.swift: .package(url: "https://github.com/julianbonomini/trueseal-sync-swift", from: "0.6.0")
import TruesealSync

let ts = try await TrueSeal.open(
    relay: "trueseal://9f2c…e41a@relay.example.com",
    storage: try FileManager.default.url(
        for: .applicationSupportDirectory, in: .userDomainMask,
        appropriateFor: nil, create: true)
)

ts.onMessage { message in
    try await store.save(message.id, message.body)
}
ts.onEvent { event in
    if case .joinRequest(let request) = event {
        try? ts.accept(requestId: request.id)
    }
}

let token = try ts.startPairing() // show it as a QR code
try ts.join(token: scannedToken) // on the other device
try ts.send(location)`,
  },
  {
    label: 'Kotlin',
    code: `// build.gradle.kts: implementation("dev.trueseal:trueseal-sync:0.6.0")
import dev.trueseal.sync.Storage
import dev.trueseal.sync.TrueSeal
import dev.trueseal.sync.TrueSealEvent
import kotlinx.coroutines.launch

val ts = TrueSeal.open(
    relay = "trueseal://9f2c…e41a@relay.example.com",
    storage = Storage.android(context),
)

ts.onMessage { message ->
    repository.save(message.id, message.body)
}
ts.onEvent { event ->
    if (event is TrueSealEvent.JoinRequestReceived) {
        scope.launch { ts.accept(event.request.id) }
    }
}

val token = ts.startPairing() // show it as a QR code
ts.join(scannedToken) // on the other device
ts.send(location)`,
  },
  {
    label: 'TypeScript',
    code: `// npm install @trueseal/sync
import { TrueSeal } from '@trueseal/sync'

const ts = await TrueSeal.open(
  'trueseal://9f2c…e41a@relay.example.com',
  { storageDir: './trueseal-state' },
)

ts.onMessage(async (message) => {
  await db.put(message.id, message.body)
})
ts.onEvent((event) => {
  if (event.type === 'joinRequest') {
    ts.accept(event.request.id)
  }
})

const token = ts.startPairing() // show it as a QR code
ts.join(scannedToken) // on the other device
await ts.send(location)`,
  },
];
---

<LandingSection
  id="integrate"
  heading="Open it, pair two devices, send."
  docs={{ href: '/docs/integrate/integrating-trueseal-sync', label: 'Read the integration guide' }}
>
  <p>
    Open a TrueSeal with your relay's address. Show the Pairing Token as a QR code on one device, join with it on the
    other, and accept the join request on the first. Then send bytes, and every device in the group receives them.
  </p>
  <p>
    Your feature list gets a new line. <em class="integrate__line">Syncs across all your devices, and no one else can
    read it.</em>
  </p>
  <p>
    This is the current SDK API, with the accept step written out: 18 lines of Swift, 19 of Kotlin and 16 of
    TypeScript, counted against the SDK repos. The 0.6 packages aren't published yet; until they are, install from
    the repos.
  </p>

  <CodeTabs slot="aside" name="integrate-code" tabs={snippets} />

  <div slot="wide" class="agent">
    <div>
      <h3 class="agent__heading">For your coding agent</h3>
      <p class="agent__text">
        Paste this into your project's <code>AGENTS.md</code>. It names the mistakes agents make with TrueSeal and
        points them at the <a href="/agents/">Agent Docs</a>, which hold the full API.
      </p>
    </div>
    <pre class="agent__snippet">{agentSnippet}</pre>
  </div>
</LandingSection>

<style>
  .integrate__line {
    font-style: normal;
    color: var(--ink);
  }

  .agent {
    display: grid;
    grid-template-columns: var(--landing-columns);
    gap: 24px 64px;
    padding-top: 40px;
    border-top: 1px solid var(--rule);
  }

  .agent > * {
    min-width: 0;
  }

  .agent__heading {
    font-size: 22px;
    font-weight: 600;
  }

  .agent__text {
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 52ch;
  }

  .agent__snippet {
    margin: 0;
    background: var(--wash);
    border-left: 2px solid var(--ink);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding: 18px 20px;
    font-size: 13px;
    line-height: 1.7;
  }
</style>
