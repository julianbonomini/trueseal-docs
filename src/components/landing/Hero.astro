---
import StatusBadge from '../ui/StatusBadge.astro';
import Button from '../ui/Button.astro';
import HeroVisual from './HeroVisual.astro';
---

<section class="hero">
  <div class="hero__content">
    <StatusBadge text="// E2EE SYNC MADE EASY //" />

    <h1 class="hero__headline">
      Private by default,<br />not by promise.
    </h1>

    <p class="hero__sub">
      Drop-in sync. Zero trust, by design.
    </p>

    <div class="hero__actions">
      <Button href="/docs/introduction" variant="primary">
        Read the docs
      </Button>
      <Button href="/showcase" variant="secondary">
        See who's building
      </Button>
    </div>
  </div>

  <div class="hero__visual">
    <HeroVisual />
  </div>
</section>

<style>
  .hero {
    width: 100%;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: var(--space-2xl) clamp(16px, 5vw, var(--space-xl));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 8fr 4fr;
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .hero__headline {
    font-size: var(--text-h1);
    font-weight: var(--weight-heading);
    line-height: var(--leading-h1);
    letter-spacing: var(--tracking-h1);
  }

  .hero__sub {
    font-size: var(--text-lede);
    line-height: 1.5;
    color: var(--ink-muted);
    border-left: 2px solid var(--ink);
    padding-left: var(--space-md);
    max-width: 560px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding-top: var(--space-md);
  }
</style>
