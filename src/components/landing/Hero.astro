---
import StatusBadge from '../ui/StatusBadge.astro';
import Button from '../ui/Button.astro';
import HeroVisual from './HeroVisual.astro';
---

<section class="hero">
  <div class="hero__content">
    <StatusBadge text="// E2EE SYNC MADE EASY //" />

    <h1 class="hero__headline">
      Private by default,<br />not by promise.
    </h1>

    <p class="hero__sub">
      Drop-in sync. Zero trust, by design.
    </p>

    <div class="hero__actions">
      <Button href="/docs/introduction" variant="primary" icon="arrow_forward">
        Read the docs
      </Button>
      <Button href="/showcase" variant="secondary" icon="arrow_outward" iconPosition="left">
        See who's building
      </Button>
    </div>
  </div>

  <div class="hero__visual">
    <HeroVisual />
  </div>
</section>

<style>
  .hero {
    width: 100%;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: var(--space-xl) var(--space-xl);
    padding-top: calc(var(--space-xl) * 2);
    padding-bottom: calc(var(--space-xl) * 2);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 8fr 4fr;
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    position: relative;
    z-index: 1;
  }

  .hero__headline {
    font-family: var(--font-sans);
    font-size: clamp(var(--text-display-size), 5vw, 64px);
    font-weight: var(--text-display-weight);
    line-height: var(--text-display-leading);
    letter-spacing: var(--text-display-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
  }

  .hero__sub {
    font-family: var(--font-sans);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--color-on-surface-variant);
    border-left: 2px solid var(--color-primary);
    padding-left: var(--space-md);
    max-width: 560px;
    margin: 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding-top: var(--space-md);
  }
</style>
