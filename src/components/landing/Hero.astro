---
// The first screen of the Landing: the promise, the two ways in and the Seal Demo below them.
import Button from '../ui/Button.astro';
import SealDemoPlaceholder from './SealDemoPlaceholder.astro';
---

<section id="hero" class="hero">
  <div class="hero__text">
    <h1 class="hero__headline">Don't give up on privacy.</h1>
    {/* TODO: brandbook section 10. "About ten lines" is unchecked against the shipped SDKs (DOCS-9). */}
    <p class="hero__lede">
      TrueSeal is the private sync primitive that makes it about ten lines of code. End-to-end encrypted sync
      for Swift, Kotlin and TypeScript, with a relay you run yourself.
    </p>
    <div class="hero__actions">
      <Button href="/docs/guides/integrating-trueseal-sync">Start integrating</Button>
      <Button variant="secondary" href="/docs/trust/threat-model">Read the threat model</Button>
    </div>
    <p class="hero__note">TrueSeal is a developer preview, and the API may change before 1.0.</p>
  </div>
  <SealDemoPlaceholder />
</section>

<style>
  .hero {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    /* 64px, not the prototype's 88px, so the demo frame starts inside a 1440x900 first screen. */
    padding: 64px var(--landing-gutter) 104px;
    display: grid;
    gap: 56px;
  }

  .hero__text {
    min-width: 0;
  }

  .hero__headline {
    font-size: var(--text-hero);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 600;
  }

  .hero__lede {
    margin-top: 28px;
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: 54ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: 36px;
  }

  .hero__note {
    margin-top: 20px;
    font-size: 14px;
    color: var(--ink-muted);
  }
</style>
