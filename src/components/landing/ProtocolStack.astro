---
import SectionHeader from './SectionHeader.astro';
import StackLayer from './StackLayer.astro';

const layers = [
  {
    layer: 'L3 // Application',
    name: 'hush-sync',
    description:
      'E2EE sync engine. Device pairing, group membership, addressed encryption, and guaranteed outbox replay. Drop it in and your data is encrypted before it leaves the device.',
    href: '/docs/components/hush-sync/overview',
    active: false,
  },
  {
    layer: 'L2 // Transport',
    name: 'hush-relay',
    description:
      'Zero-knowledge blob router. Holds ciphertext for offline devices and delivers on reconnect. Self-hostable on any server. Structurally incapable of reading content.',
    href: '/docs/components/hush-relay/overview',
    active: false,
  },
  {
    layer: 'L1 // Crypto Primitive',
    name: 'hush-noise',
    description:
      'Noise Protocol Framework in Rust. Authenticated, forward-secret encrypted channels — the same foundation as WireGuard and Signal.',
    href: '/docs/components/hush-noise/overview',
    active: false,
  },
];
---

<section class="protocol-stack">
  <div class="protocol-stack__inner">
    <SectionHeader title="Protocol Stack" subtitle="ARCHITECTURE_LAYERS" />

    <div class="protocol-stack__grid">
      {layers.map(layer => <StackLayer {...layer} />)}
    </div>
  </div>
</section>

<style>
  .protocol-stack {
    width: 100%;
    border-top: 1px solid var(--color-primary);
    background: var(--color-surface-container-low);
  }

  .protocol-stack__inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: calc(var(--space-xl) * 2) var(--space-xl);
  }

  .protocol-stack__grid {
    border: 1px solid var(--color-primary);
    /* 1px gaps between rows using the parent background as the "gap color" */
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--color-primary);
  }
</style>
