---
---

<section class="cta-section">
  <div class="cta-section__inner">
    <div class="cta-section__content">
      <p class="cta-section__label">START BUILDING</p>
      <h2 class="cta-section__headline">
        Pick your platform.<br />Your data stays yours.
      </h2>
      <p class="cta-section__body">
        trueseal-sync ships as a native SDK for Swift, Kotlin, and TypeScript.
        Drop it in and encryption happens before data leaves the device —
        no server changes, no key management, no trust required.
      </p>
      <a href="/docs/sdks" class="cta-section__btn">
        Browse SDKs
      </a>
    </div>

    <div class="cta-section__aside">
      <span class="cta-section__aside-label">SUPPORTED PLATFORMS</span>
      <div class="cta-section__platforms">
        <span>Swift</span>
        <span>Kotlin</span>
        <span>TypeScript</span>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    width: 100%;
    border-top: 1px solid var(--rule);
  }

  .cta-section__inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: var(--space-2xl) clamp(16px, 5vw, var(--space-xl));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 768px) {
    .cta-section__inner {
      grid-template-columns: 3fr 2fr;
    }
  }

  .cta-section__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .cta-section__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--ink-muted);
  }

  .cta-section__headline {
    font-size: var(--text-h2);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-h2);
    line-height: 1.3;
  }

  .cta-section__body {
    font-size: var(--text-ui);
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 480px;
  }

  .cta-section__btn {
    align-self: flex-start;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-decoration: none;
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--ink);
  }

  .cta-section__btn:hover {
    border-color: var(--seal);
  }

  .cta-section__aside {
    border: 1px solid var(--rule);
    padding: var(--space-xl) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    align-items: center;
    text-align: center;
    background: var(--wash);
  }

  .cta-section__aside-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--ink-muted);
  }

  .cta-section__platforms {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
  }

  .cta-section__platforms span {
    font-family: var(--font-mono);
    font-size: var(--text-code);
    font-weight: 600;
    border: 1px solid var(--rule);
    padding: var(--space-xs) var(--space-md);
  }
</style>
