---
// The site header: wordmark, the Docs / Agent Docs switch, the version label, GitHub and
// the Theme toggle. nav.ts owns which path belongs to which surface.
import Wordmark from './Wordmark.astro';
import ThemeToggle from '../ui/ThemeToggle';
import { versionLabel } from '../../config/site';
import { surfaceOf, surfaces } from '../../config/nav';

const current = surfaceOf(Astro.url.pathname);
---

<header class="navbar">
  <Wordmark />
  <nav class="navbar__surfaces" aria-label="Documentation">
    {Object.entries(surfaces).map(([surface, { label, home }]) => (
      <a href={home} aria-current={current === surface ? 'true' : undefined}>{label}</a>
    ))}
  </nav>
  <span class="navbar__version">{versionLabel}</span>
  <div class="navbar__right">
    <a class="navbar__github" href="https://github.com/julianbonomini">GitHub</a>
    <ThemeToggle client:load />
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header-height);
    padding: 0 24px;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .navbar__surfaces {
    display: flex;
    gap: 4px;
  }

  .navbar__surfaces a {
    font-size: var(--text-ui);
    padding: 6px 12px;
    border: 1px solid transparent;
    color: var(--ink-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .navbar__surfaces a:hover {
    color: var(--ink);
  }

  .navbar__surfaces [aria-current] {
    color: var(--ink);
    border-color: var(--ink);
  }

  .navbar__version {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .navbar__right {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-left: auto;
  }

  .navbar__github {
    font-size: var(--text-ui);
    color: var(--ink-muted);
    text-decoration: none;
  }

  .navbar__github:hover {
    color: var(--ink);
  }

  @media (max-width: 639px) {
    .navbar {
      padding: 0 16px;
      gap: 12px;
    }

    .navbar__surfaces a {
      padding: 6px 8px;
    }

    .navbar__version,
    .navbar__github {
      display: none;
    }
  }
</style>
