---
interface Check {
  label: string;
}

interface PhaseCode {
  lang: string;
  content: string;
}

interface Phase {
  number: string;
  title: string;
  description: string;
  code?: PhaseCode;
  checks?: Check[];
}

interface Props {
  phases: Phase[];
}

const { phases } = Astro.props;

// The page's Markdown version reads this in place of the rows.
const markdown = phases
  .map(phase =>
    [
      `**Phase ${phase.number}: ${phase.title}**`,
      phase.description,
      ...(phase.code ? [`\`\`\`${phase.code.lang}\n${phase.code.content.trim()}\n\`\`\``] : []),
      ...(phase.checks?.length ? [phase.checks.map(check => `- ${check.label}`).join('\n')] : []),
    ].join('\n\n'),
  )
  .join('\n\n');
---

<div class="phase-stack" data-markdown={markdown}>
  {phases.map((phase, i) => (
    <div class:list={['phase-row', { 'phase-row--last': i === phases.length - 1 }]}>

      <!-- Left column -->
      <div class="phase-row__label">
        <span class="phase-row__number">Phase {phase.number}</span>
        <span class="phase-row__title">{phase.title}</span>
      </div>

      <!-- Right column -->
      <div class="phase-row__content">
        <p class="phase-row__desc">{phase.description}</p>

        {phase.code && (
          <div class="phase-row__code">
            <pre><code>{phase.code.content.trim()}</code></pre>
          </div>
        )}

        {phase.checks && phase.checks.length > 0 && (
          <ul class="phase-row__checks">
            {phase.checks.map(check => (
              <li class="phase-check">{check.label}</li>
            ))}
          </ul>
        )}
      </div>

    </div>
  ))}
</div>

<style>
  .phase-stack {
    border: 1px solid var(--rule);
    margin-bottom: var(--space-lg);
  }

  .phase-row {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: var(--space-xl);
    padding: var(--space-xl);
    border-bottom: 1px solid var(--rule);
  }

  .phase-row--last {
    border-bottom: none;
  }

  .phase-row__label {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .phase-row__number {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--ink-muted);
  }

  .phase-row__title {
    font-family: var(--font-mono);
    font-size: var(--text-code);
    font-weight: 600;
  }

  .phase-row__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    min-width: 0;
  }

  .phase-row__desc {
    font-size: var(--text-ui);
    line-height: 1.6;
    margin: 0;
  }

  .phase-row__code pre {
    margin: 0;
  }

  .phase-row__checks {
    list-style: square;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-left: var(--space-lg);
    margin: 0;
  }

  .phase-check {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--ink-muted);
    margin: 0;
  }

  @media (max-width: 639px) {
    .phase-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-md);
      padding: var(--space-lg) var(--space-md);
    }
  }
</style>
