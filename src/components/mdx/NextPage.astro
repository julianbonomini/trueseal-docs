---
interface Props {
  href: string;
  label: string;
  prevHref?: string;
  prevLabel?: string;
}
const { href, label, prevHref, prevLabel } = Astro.props;
---

<nav class="next-page">
  {prevHref && prevLabel && (
    <a href={prevHref} class="next-page__link">
      <span class="next-page__hint">Previous</span>
      <span class="next-page__label">{prevLabel}</span>
    </a>
  )}
  <a href={href} class:list={['next-page__link', 'next-page__link--next', { 'next-page__link--solo': !prevHref }]}>
    <span class="next-page__hint">Next</span>
    <span class="next-page__label">{label}</span>
  </a>
</nav>

<style>
  .next-page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 72px;
    border: 1px solid var(--ink);
  }

  .next-page__link {
    display: grid;
    gap: 4px;
    padding: 16px 20px;
    color: var(--ink);
    text-decoration: none;
  }

  .next-page__link--next {
    text-align: right;
  }

  .next-page__link + .next-page__link {
    border-left: 1px solid var(--ink);
  }

  .next-page__link--solo {
    grid-column: 1 / -1;
  }

  .next-page__hint {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--ink-muted);
  }

  .next-page__label {
    font-size: var(--text-ui);
    font-weight: 600;
  }

  .next-page__link:hover .next-page__label {
    color: var(--seal);
  }

  @media (max-width: 639px) {
    .next-page {
      grid-template-columns: 1fr;
    }

    .next-page__link + .next-page__link {
      border-left: none;
      border-top: 1px solid var(--ink);
    }
  }
</style>
