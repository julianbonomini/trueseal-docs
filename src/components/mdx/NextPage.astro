---
// Previous and next links at the foot of a docs page. Renders nothing when given neither.
import type { DocLink } from '../../config/nav';

interface Props {
  prev?: DocLink;
  next?: DocLink;
}
const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav class="next-page">
    {prev && (
      <a href={prev.href} class:list={['next-page__link', { 'next-page__link--solo': !next }]}>
        <span class="next-page__hint">Previous</span>
        <span class="next-page__label">{prev.title}</span>
      </a>
    )}
    {next && (
      <a href={next.href} class:list={['next-page__link', 'next-page__link--next', { 'next-page__link--solo': !prev }]}>
        <span class="next-page__hint">Next</span>
        <span class="next-page__label">{next.title}</span>
      </a>
    )}
  </nav>
)}

<style>
  .next-page {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 72px;
    border: 1px solid var(--ink);
  }

  .next-page__link {
    display: grid;
    gap: 4px;
    padding: 16px 20px;
    color: var(--ink);
    text-decoration: none;
  }

  .next-page__link--next {
    text-align: right;
  }

  .next-page__link + .next-page__link {
    border-left: 1px solid var(--ink);
  }

  .next-page__link--solo {
    grid-column: 1 / -1;
  }

  .next-page__hint {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--ink-muted);
  }

  .next-page__label {
    font-size: var(--text-ui);
    font-weight: 600;
  }

  .next-page__link:hover .next-page__label {
    color: var(--seal);
  }

  @media (max-width: 639px) {
    .next-page {
      grid-template-columns: 1fr;
    }

    .next-page__link + .next-page__link {
      border-left: none;
      border-top: 1px solid var(--ink);
    }
  }
</style>
