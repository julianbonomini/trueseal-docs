---
interface Props {
  variant?: 'note' | 'tip' | 'warning' | 'danger';
}
const { variant = 'note' } = Astro.props;

const labels = {
  note:    'Note',
  tip:     'Tip',
  warning: 'Warning',
  danger:  'Danger',
};
---

<div class:list={['callout', `callout--${variant}`]}>
  <p class="callout__label">{labels[variant]}</p>
  <div class="callout__body">
    <slot />
  </div>
</div>

<style>
  .callout {
    border-left: 2px solid var(--ink-muted);
    padding: 4px 0 4px 20px;
    margin: var(--space-xl) 0;
    color: var(--ink);
  }

  .callout--warning,
  .callout--danger {
    border-left-color: var(--ink);
  }

  .callout__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    margin-bottom: 4px;
  }

  .callout--danger .callout__label {
    font-weight: 600;
  }

  .callout__body {
    font-size: 16px;
    line-height: 1.6;
  }

  .callout__body :global(p) {
    margin: 0;
    font-size: inherit;
  }
</style>
