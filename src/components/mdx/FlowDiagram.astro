---
interface Step {
  label: string;
}

interface NodePanel {
  id: string;
  role: string;
  steps: Step[];
}

interface CenterPanel {
  title: string;
  subtitle: string;
  meta: { label: string; value: string }[];
}

interface Props {
  left: NodePanel;
  center: CenterPanel;
  right: NodePanel;
}

const { left, center, right } = Astro.props;
---

<div class="flow-diagram">
  <div class="flow-node">
    <div class="flow-node__header">
      <span class="flow-node__id">{left.id}</span>
      <span class="flow-node__role">{left.role}</span>
    </div>
    <div class="flow-node__steps">
      {left.steps.map(step => <span>{step.label}</span>)}
    </div>
    <span class="flow-arrow" aria-hidden="true"></span>
  </div>

  <div class="flow-relay">
    <span class="flow-relay__title">{center.title}</span>
    <span class="flow-relay__subtitle">{center.subtitle}</span>
    <div class="flow-relay__meta">
      {center.meta.map(m => (
        <span>{m.label}: {m.value}</span>
      ))}
    </div>
    <span class="flow-arrow" aria-hidden="true"></span>
  </div>

  <div class="flow-node">
    <div class="flow-node__header">
      <span class="flow-node__id">{right.id}</span>
      <span class="flow-node__role flow-node__role--solid">{right.role}</span>
    </div>
    <div class="flow-node__steps">
      {right.steps.map(step => <span>{step.label}</span>)}
    </div>
  </div>
</div>

<style>
  .flow-diagram {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--rule);
    margin-bottom: var(--space-lg);
  }

  .flow-diagram > * + * {
    border-left: 1px solid var(--rule);
  }

  .flow-node,
  .flow-relay {
    position: relative;
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .flow-node__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .flow-node__id {
    font-family: var(--font-mono);
    font-size: var(--text-code);
    font-weight: 600;
  }

  .flow-node__role {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    padding: 2px var(--space-sm);
    border: 1px solid var(--ink);
  }

  .flow-node__role--solid {
    color: var(--paper);
    background: var(--ink);
  }

  .flow-node__steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--ink-muted);
  }

  .flow-relay {
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-xs);
    background: var(--wash);
  }

  .flow-relay__title {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
  }

  .flow-relay__subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--ink-muted);
  }

  .flow-relay__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-md);
    width: 100%;
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--ink-muted);
  }

  /* The arrow sits on the border to the next panel; its paper backing hides the rule behind it. */
  .flow-arrow {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translate(50%, -50%);
    z-index: 1;
    padding: 0 2px;
    background: var(--paper);
    font-family: var(--font-mono);
    color: var(--ink-muted);
    line-height: 1;
  }

  .flow-arrow::before {
    content: '→';
  }

  @media (max-width: 639px) {
    .flow-diagram {
      grid-template-columns: minmax(0, 1fr);
    }

    .flow-diagram > * + * {
      border-left: none;
      border-top: 1px solid var(--rule);
    }

    .flow-arrow {
      top: auto;
      right: auto;
      bottom: 0;
      left: 50%;
      transform: translate(-50%, 50%);
      padding: 2px 0;
    }

    .flow-arrow::before {
      content: '↓';
    }
  }
</style>
