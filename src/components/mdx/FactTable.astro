---
// Every Shared Fact of one value group, or every value set, as a table: name, value, meaning, source. Cases render through ApiEntries.
import { factTable, type TableGroup, type FactPart } from '../../facts/facts';
import FactParts from './FactParts.astro';

interface Props {
  group: TableGroup;
}
const { columns, rows } = factTable(Astro.props.group);
---
<table>
  <thead>
    <tr>{columns.map(column => <th>{column}</th>)}</tr>
  </thead>
  <tbody>
    {rows.map(row => (
      <tr id={row.anchor}>
        <td><FactParts parts={[row.name]} /></td>
        <td>{row.value.map((part: FactPart, index: number) => <>{index > 0 && ', '}<FactParts parts={[part]} /></>)}</td>
        <td><FactParts parts={row.meaning} /></td>
        <td>{row.source}</td>
      </tr>
    ))}
  </tbody>
</table>
