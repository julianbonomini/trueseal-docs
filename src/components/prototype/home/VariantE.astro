---
// PROTOTYPE (throwaway, trueseal-roadmap#17).
// Variant E: the brandbook (brand/90_SYNTHESIS.md) applied to D's structure.
// Warm paper, ink, one wax-seal red used only for meaning (cursor, links, focus, sealed state).
// Hero demo uses the flagship scenario, family location sharing: drag Mum's dot; the relay
// only ever holds sealed bytes; your phone shows where she is.
// Copy follows the brand voice rules (no dashes as punctuation, no "not X, it's Y", no emoji).
// Claims flagged in brandbook section 10 ("about ten lines", "one container") are unverified.
import { snippets, installs } from './content';
import ThemeToggle from '../../ui/ThemeToggle.tsx';

const agentSnippet = `## TrueSeal
This app syncs user data with TrueSeal (@trueseal/sync).
Before changing sync code, read https://trueseal.dev/agents/llms.txt.
Payloads are opaque bytes up to the published limit. Conflict
resolution and the pairing screens belong to this app.`;
---

<div class="e">
  <header class="e__nav">
    <a class="e__logo" href="/" aria-label="TrueSeal home">trueseal<span class="e__cursor" aria-hidden="true"></span></a>
    <nav aria-label="Main">
      <a href="#">Docs</a>
      <a href="#">Agent Docs</a>
      <a href="#">Threat model</a>
      <a href="#">Why TrueSeal</a>
    </nav>
    <div class="e__nav-right">
      <a href="#">GitHub</a>
      <ThemeToggle client:load />
    </div>
  </header>

  <section class="e__hero">
    <div class="e__hero-copy">
      <h1>Don’t give up on privacy.</h1>
      <p class="e__lede">
        TrueSeal is the private sync primitive that makes it about ten lines of code.
        End-to-end encrypted sync for Swift, Kotlin and TypeScript, with a relay you run yourself.
      </p>
      <div class="e__ctas">
        <a class="e__btn e__btn--primary" href="#">Start the quickstart</a>
        <a class="e__btn" href="#">Read the threat model</a>
      </div>
      <p class="e__preview">Developer preview. Version 0.6 may change before 1.0.</p>
    </div>

    <figure class="e__demo" data-demo>
      <div class="e__pane">
        <p class="e__pane-title">Mum’s phone</p>
        <div class="e__map" data-src role="application" aria-label="Drag to move Mum’s location">
          <span class="e__dot" data-src-dot></span>
        </div>
        <p class="e__coords" data-src-coords></p>
      </div>
      <div class="e__pane e__pane--relay">
        <p class="e__pane-title">The relay</p>
        <ol class="e__log" data-log aria-live="off"></ol>
      </div>
      <div class="e__pane">
        <p class="e__pane-title">Your phone</p>
        <div class="e__map"><span class="e__dot" data-dst-dot></span></div>
        <p class="e__coords" data-dst-coords>Waiting for Mum</p>
      </div>
      <figcaption>
        Drag Mum’s dot. Each update is encrypted in this page before it moves. The relay stores sealed bytes,
        a size and a time, and can’t tell where she is.
      </figcaption>
    </figure>
  </section>

  <section class="e__sec" id="overview">
    <p class="e__kicker">Overview</p>
    <div class="e__sec-grid">
      <h2>Private sync usually turns into a protocol project.</h2>
      <div class="e__prose">
        <p>
          You’re building an app where a few devices share something personal. A family’s locations,
          passwords between your own laptops, a clipboard. Making that private means pairing, key sharing,
          an offline outbox and membership, so most apps ship it readable by whoever runs the server.
        </p>
        <p>
          TrueSeal does those parts for you. Your data model, your conflict rules and your pairing screens stay yours.
        </p>
      </div>
    </div>

    <div class="e__table-wrap">
      <table class="e__compare">
        <thead>
          <tr><th scope="col"><span class="e__sr">Feature</span></th><th scope="col">Your own backend</th><th scope="col">libsodium and your own pairing</th><th scope="col">CloudKit encrypted fields</th><th scope="col" class="e__us">TrueSeal</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">Server can read the data</th><td>Yes</td><td>No</td><td>No, for those fields</td><td class="e__us">No</td></tr>
          <tr><th scope="row">Pairing and membership</th><td>You build it</td><td>You build it</td><td>Apple ID</td><td class="e__us">Included</td></tr>
          <tr><th scope="row">Offline outbox and ordering</th><td>You build it</td><td>You build it</td><td>Included</td><td class="e__us">Included</td></tr>
          <tr><th scope="row">Platforms</th><td>Any</td><td>Any</td><td>Apple</td><td class="e__us">Swift, Kotlin, TypeScript</td></tr>
          <tr><th scope="row">Runs on your own server</th><td>Yes</td><td>Yes</td><td>No</td><td class="e__us">Yes</td></tr>
          <tr><th scope="row">Ready for production</th><td>Yours to judge</td><td>Yours to judge</td><td>Yes</td><td class="e__us">Not yet, it’s a preview</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="e__sec" id="integrate">
    <p class="e__kicker">Integrate</p>
    <div class="e__sec-grid">
      <div>
        <h2>About ten lines.</h2>
        <div class="e__prose">
          <p>Open a TrueSeal with your relay’s address. Show the pairing code as a QR on one device and scan it on the other. Then send bytes, and every device in the group receives them.</p>
          <p>Your feature list gets a new line. <em>Syncs across all your devices, and no one else can read it.</em></p>
        </div>
        <p class="e__install"><code>{installs.ts}</code></p>
      </div>
      <div class="e__code">
        <div class="e__tabs" role="tablist">
          <button role="tab" aria-selected="true" data-tab="ts">TypeScript</button>
          <button role="tab" aria-selected="false" data-tab="swift">Swift</button>
          <button role="tab" aria-selected="false" data-tab="kotlin">Kotlin</button>
        </div>
        <pre data-panel="ts">{snippets.ts}</pre>
        <pre data-panel="swift" hidden>{snippets.swift}</pre>
        <pre data-panel="kotlin" hidden>{snippets.kotlin}</pre>
      </div>
    </div>

    <div class="e__agent">
      <div>
        <h3>Working with a coding agent?</h3>
        <p>Paste this into your project’s <code>AGENTS.md</code>. It points the agent at the Agent Docs, which hold the full API.</p>
      </div>
      <pre>{agentSnippet}</pre>
    </div>
  </section>

  <section class="e__sec" id="operate">
    <p class="e__kicker">Operate</p>
    <div class="e__sec-grid">
      <div>
        <h2>A relay in one container.</h2>
        <div class="e__prose">
          <p>
            The relay holds sealed bytes for devices that are offline, which in most families means Dad’s phone.
            It drops them once they’re delivered or expire. Back up one keypair and one SQLite file.
          </p>
        </div>
      </div>
      <pre class="e__term"><span class="e__prompt">$</span> {installs.relay}
<span class="e__out">relay address  trueseal://9f2c…e41a@localhost</span></pre>
    </div>
  </section>

  <section class="e__sec" id="trust">
    <p class="e__kicker">Trust</p>
    <div class="e__sec-grid">
      <h2>What the relay sees.</h2>
      <div class="e__prose">
        <p>The relay can’t read or forge your messages. It does see some metadata, and the threat model lists all of it, with the test behind each claim.</p>
      </div>
    </div>
    <div class="e__sees">
      <div>
        <h3>It can’t see</h3>
        <ul>
          <li>What’s in a message</li>
          <li>Names of groups or members</li>
          <li>Any account, because there isn’t one</li>
        </ul>
      </div>
      <div>
        <h3>It can see</h3>
        <ul>
          <li>Which devices are online</li>
          <li>When a message arrives and roughly how big it is</li>
          <li>Which devices receive the same messages, so likely members of one group</li>
        </ul>
      </div>
    </div>
    <p class="e__note">It doesn’t record or use your IP address. <a href="#">Read the threat model</a></p>
  </section>

  <section class="e__close">
    <p class="e__signature">The best privacy feature is the one nobody had to build.</p>
    <p class="e__free">Free to use, free to host, and about ten lines to add. Apache-2.0.</p>
    <a class="e__btn e__btn--primary" href="#">Start the quickstart</a>
    <p class="e__byline">Built by Julian Bonomini. <a href="#">Why TrueSeal exists</a></p>
  </section>

  <footer class="e__foot">
    <p class="e__proto-note">Prototype. Human Docs sidebar on the left four columns, Agent Docs as its own tree.</p>
    <div class="e__foot-grid">
      {[
        ['Overview', ['What TrueSeal is', 'How it works', 'Is it right for my app?', 'Why TrueSeal exists', 'Developer preview']],
        ['Integrate', ['Quickstart for Swift', 'Quickstart for Kotlin', 'Quickstart for TypeScript', 'Pair devices', 'Send and receive', 'Members and leaving', 'Destroy a group', 'Delivery issues']],
        ['Operate', ['Run a relay', 'Relay address and keypair', 'Limits and quotas', 'Backups and upgrades']],
        ['Trust', ['Threat model', 'Known limitations', 'Report a vulnerability']],
        ['Agent Docs', ['Agent Snippet', 'llms.txt', 'SDK API', 'Errors and events', 'Limits', 'Protocol and wire format', 'Compatibility table']],
      ].map(([t, items]) => (
        <div><h4>{t}</h4><ul>{(items as string[]).map(i => <li><a href="#">{i}</a></li>)}</ul></div>
      ))}
    </div>
  </footer>
</div>

<script>
  // Code tabs
  document.querySelectorAll<HTMLElement>('.e__code').forEach(box => {
    const tabs = box.querySelectorAll<HTMLButtonElement>('[data-tab]');
    tabs.forEach(t => t.addEventListener('click', () => {
      tabs.forEach(x => x.setAttribute('aria-selected', String(x === t)));
      box.querySelectorAll<HTMLElement>('[data-panel]').forEach(p => (p.hidden = p.dataset.panel !== t.dataset.tab));
    }));
  });

  // Location demo
  const root = document.querySelector<HTMLElement>('.e [data-demo]');
  if (root) {
    const src = root.querySelector<HTMLElement>('[data-src]')!;
    const srcDot = root.querySelector<HTMLElement>('[data-src-dot]')!;
    const dstDot = root.querySelector<HTMLElement>('[data-dst-dot]')!;
    const srcCoords = root.querySelector<HTMLElement>('[data-src-coords]')!;
    const dstCoords = root.querySelector<HTMLElement>('[data-dst-coords]')!;
    const log = root.querySelector<HTMLElement>('[data-log]')!;
    const keyP = crypto.subtle.generateKey({ name: 'AES-GCM', length: 256 }, false, ['encrypt']);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pos = { x: 0.42, y: 0.58 };
    let lastSent = 0, pending: number | undefined, wander = !reduce, t = 0;

    const toLatLng = (p: { x: number; y: number }) =>
      `${(51.535 - p.y * 0.03).toFixed(4)}, ${(-0.175 + p.x * 0.05).toFixed(4)}`;
    const place = (dot: HTMLElement, p: { x: number; y: number }) => {
      dot.style.left = `${p.x * 100}%`; dot.style.top = `${p.y * 100}%`;
    };

    async function send(p: { x: number; y: number }) {
      const text = JSON.stringify({ at: toLatLng(p), t: Date.now() });
      const iv = crypto.getRandomValues(new Uint8Array(12));
      const ct = new Uint8Array(await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, await keyP, new TextEncoder().encode(text)));
      const hex = Array.from(ct.slice(0, 10), b => b.toString(16).padStart(2, '0')).join('');
      const li = document.createElement('li');
      const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      li.innerHTML = `<span class="e__seal" aria-hidden="true"></span><code>${hex}…</code><span>${ct.length + 12} B</span><span>${time}</span>`;
      log.prepend(li);
      while (log.children.length > 6) log.lastElementChild!.remove();
      const snap = { ...p };
      setTimeout(() => { place(dstDot, snap); dstDot.classList.add('on'); dstCoords.textContent = `Mum is at ${toLatLng(snap)}`; }, 380);
    }

    function update(p: { x: number; y: number }) {
      pos = p; place(srcDot, p); srcCoords.textContent = toLatLng(p);
      const now = performance.now();
      if (now - lastSent > 700) { lastSent = now; send(p); }
      else { clearTimeout(pending); pending = window.setTimeout(() => { lastSent = performance.now(); send(pos); }, 700); }
    }

    function fromEvent(e: PointerEvent) {
      const r = src.getBoundingClientRect();
      return { x: Math.min(0.95, Math.max(0.05, (e.clientX - r.left) / r.width)), y: Math.min(0.95, Math.max(0.05, (e.clientY - r.top) / r.height)) };
    }
    src.addEventListener('pointerdown', e => { wander = false; src.setPointerCapture(e.pointerId); update(fromEvent(e)); });
    src.addEventListener('pointermove', e => { if (src.hasPointerCapture(e.pointerId)) update(fromEvent(e)); });

    update(pos);
    const drift = () => {
      if (!wander) return;
      t += 0.012;
      update({ x: 0.5 + Math.sin(t) * 0.28, y: 0.5 + Math.sin(t * 1.7) * 0.22 });
      requestAnimationFrame(drift);
    };
    if (wander) setTimeout(drift, 800);
  }
</script>

<style>
  .e {
    --paper: #f5f1e8; --ink: #1a1814; --ink-muted: #5c574e; --seal: #a3301e;
    --rule: color-mix(in srgb, var(--ink-muted) 35%, transparent);
    --wash: color-mix(in srgb, var(--ink) 4%, var(--paper));
    background: var(--paper); color: var(--ink);
    font-family: var(--font-sans);
  }
  :global([data-theme='dark']) .e { --paper: #161412; --ink: #ede7da; --ink-muted: #9c958a; --seal: #e4644b; }
  .e a { color: var(--seal); text-underline-offset: 3px; }
  .e :focus-visible { outline: 2px solid var(--seal); outline-offset: 3px; }
  .e code, .e pre { font-family: var(--font-mono); }
  .e__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .e__nav { display: flex; align-items: center; gap: 40px; max-width: 1200px; margin: 0 auto; padding: 20px 24px; }
  .e__logo { font: 500 20px var(--font-mono); color: var(--ink) !important; text-decoration: none; display: inline-flex; align-items: center; letter-spacing: -.01em; }
  .e__cursor { display: inline-block; width: .6em; height: 1.05em; margin-left: 3px; background: var(--seal); animation: e-blink 1.1s steps(1) infinite; }
  @keyframes e-blink { 50% { opacity: 0; } }
  .e__nav nav { display: flex; gap: 28px; flex: 1; font-size: 15px; }
  .e__nav nav a, .e__nav-right a { color: var(--ink-muted); text-decoration: none; }
  .e__nav nav a:hover, .e__nav-right a:hover { color: var(--ink); }
  .e__nav-right { display: flex; align-items: center; gap: 20px; font-size: 15px; }
  @media (max-width: 820px) { .e__nav nav { display: none; } .e__nav { justify-content: space-between; } }

  .e__hero { max-width: 1200px; margin: 0 auto; padding: 88px 24px 112px; display: grid; gap: 64px; }
  .e__hero h1 { font-size: clamp(44px, 7.2vw, 104px); line-height: .98; letter-spacing: -.045em; font-weight: 600; }
  .e__lede { font-size: clamp(18px, 1.6vw, 21px); line-height: 1.55; color: var(--ink-muted); max-width: 54ch; margin: 28px 0 36px; }
  .e__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .e__btn { font-size: 15px; font-weight: 500; padding: 13px 22px; border: 1px solid var(--ink); color: var(--ink) !important; text-decoration: none; display: inline-block; }
  .e__btn--primary { background: var(--ink); color: var(--paper) !important; }
  .e__btn:hover { border-color: var(--seal); }
  .e__preview { margin-top: 20px; font-size: 14px; color: var(--ink-muted); }

  .e__demo { display: grid; grid-template-columns: 1fr; border: 1px solid var(--ink); margin: 0; }
  @media (min-width: 900px) { .e__demo { grid-template-columns: 1fr 1.15fr 1fr; } }
  .e__pane { padding: 20px; display: grid; gap: 14px; align-content: start; min-width: 0; }
  .e__pane + .e__pane { border-top: 1px solid var(--ink); }
  @media (min-width: 900px) { .e__pane + .e__pane { border-top: 0; border-left: 1px solid var(--ink); } }
  .e__pane--relay { background: var(--wash); }
  .e__pane-title { font-size: 15px; font-weight: 600; }
  .e__map { position: relative; aspect-ratio: 4 / 3; border: 1px solid var(--rule); touch-action: none;
    background-image: linear-gradient(var(--rule) 1px, transparent 1px), linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 24px 24px; }
  [data-src] { cursor: grab; }
  .e__dot { position: absolute; width: 14px; height: 14px; margin: -7px 0 0 -7px; background: var(--ink); border-radius: 50%; box-shadow: 0 0 0 5px color-mix(in srgb, var(--ink) 15%, transparent); }
  [data-dst-dot] { opacity: 0; transition: left .35s ease-out, top .35s ease-out, opacity .2s; }
  [data-dst-dot].on { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { [data-dst-dot] { transition: none; } .e__cursor { animation: none; } }
  .e__coords { font: 13px var(--font-mono); color: var(--ink-muted); min-height: 1.4em; }
  .e__log { list-style: none; display: grid; gap: 0; font-size: 12px; }
  .e__log :global(li) { display: grid; grid-template-columns: 12px 1fr auto auto; gap: 10px; align-items: center; padding: 9px 0; border-bottom: 1px solid var(--rule); font-family: var(--font-mono); color: var(--ink-muted); }
  .e__log :global(li:first-child) { color: var(--ink); }
  .e__log :global(code) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .e__log :global(.e__seal) { width: 10px; height: 10px; background: var(--seal); }
  .e__demo figcaption { grid-column: 1 / -1; border-top: 1px solid var(--ink); padding: 14px 20px; font-size: 14px; color: var(--ink-muted); }

  .e__sec { max-width: 1200px; margin: 0 auto; padding: 104px 24px; border-top: 1px solid var(--rule); }
  .e__kicker { font: 500 14px var(--font-mono); color: var(--ink-muted); margin-bottom: 20px; }
  .e__sec-grid { display: grid; grid-template-columns: 1fr; gap: 24px 64px; align-items: start; }
  @media (min-width: 960px) { .e__sec-grid { grid-template-columns: 5fr 6fr; } }
  .e__sec h2 { font-size: clamp(30px, 3.8vw, 48px); line-height: 1.06; letter-spacing: -.03em; font-weight: 600; max-width: 18ch; }
  .e__prose { display: grid; gap: 16px; font-size: 18px; line-height: 1.6; color: var(--ink-muted); max-width: 60ch; }
  .e__prose em { font-style: normal; color: var(--ink); }
  .e__sec-grid > div > h2 + .e__prose { margin-top: 24px; }
  .e__install { margin-top: 24px; font-size: 14px; }

  .e__table-wrap { overflow-x: auto; margin-top: 56px; }
  .e__compare { width: 100%; min-width: 760px; border-collapse: collapse; font-size: 15px; }
  .e__compare th, .e__compare td { text-align: left; padding: 15px 16px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .e__compare thead th { font-weight: 500; color: var(--ink-muted); border-bottom-color: var(--ink); }
  .e__compare tbody th { font-weight: 500; }
  .e__compare td { color: var(--ink-muted); }
  .e__compare .e__us { color: var(--ink); font-weight: 600; border-left: 1px solid var(--ink); border-right: 1px solid var(--ink); }
  .e__compare thead .e__us { border-top: 1px solid var(--ink); color: var(--ink); }
  .e__compare tbody tr:last-child .e__us { border-bottom: 1px solid var(--ink); }

  .e__code { border: 1px solid var(--ink); min-width: 0; }
  .e__tabs { display: flex; border-bottom: 1px solid var(--rule); }
  .e__tabs button { all: unset; cursor: pointer; font-size: 14px; padding: 11px 18px; color: var(--ink-muted); }
  .e__tabs button[aria-selected='true'] { color: var(--ink); box-shadow: inset 0 -2px var(--ink); }
  .e__tabs button:focus-visible { outline: 2px solid var(--seal); outline-offset: -2px; }
  .e__code pre { font-size: 13px; line-height: 1.7; padding: 22px; overflow-x: auto; }

  .e__agent { margin-top: 64px; display: grid; grid-template-columns: 1fr; gap: 24px 64px; padding-top: 40px; border-top: 1px solid var(--rule); }
  @media (min-width: 960px) { .e__agent { grid-template-columns: 5fr 6fr; } }
  .e__agent h3 { font-size: 22px; font-weight: 600; margin-bottom: 10px; }
  .e__agent p { color: var(--ink-muted); font-size: 16px; line-height: 1.6; }
  .e__agent pre { font-size: 13px; line-height: 1.65; padding: 18px 20px; background: var(--wash); border-left: 2px solid var(--ink); white-space: pre-wrap; }

  .e__term { font-size: 13px; line-height: 1.8; padding: 22px; background: var(--ink); color: var(--paper); overflow-x: auto; white-space: pre-wrap; word-break: break-all; min-width: 0; }
  .e__prompt, .e__out { opacity: .6; }
  .e__prompt { margin-right: 8px; }

  .e__sees { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); border: 1px solid var(--ink); margin: 56px 0 20px; }
  .e__sees > div { padding: 28px; }
  .e__sees > div + div { border-left: 1px solid var(--ink); background: var(--wash); }
  @media (max-width: 660px) { .e__sees > div + div { border-left: 0; border-top: 1px solid var(--ink); } }
  .e__sees h3 { font-size: 18px; font-weight: 600; margin-bottom: 16px; }
  .e__sees ul { display: grid; gap: 10px; padding-left: 20px; font-size: 16px; }
  .e__note { font-size: 15px; color: var(--ink-muted); }

  .e__close { max-width: 1200px; margin: 0 auto; padding: 136px 24px 112px; border-top: 1px solid var(--ink); }
  .e__signature { font-size: clamp(32px, 4.6vw, 64px); line-height: 1.04; letter-spacing: -.035em; font-weight: 600; max-width: 20ch; }
  .e__free { font-size: 19px; color: var(--ink-muted); margin: 28px 0 36px; }
  .e__byline { margin-top: 56px; font-size: 15px; color: var(--ink-muted); }

  .e__foot { border-top: 1px solid var(--rule); }
  .e__foot > * { max-width: 1200px; margin-inline: auto; padding-inline: 24px; }
  .e__proto-note { padding-top: 48px; font: 600 11px var(--font-mono); color: #ff2d78; }
  .e__foot-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 32px; padding-block: 24px 120px; }
  .e__foot h4 { font-size: 14px; font-weight: 600; margin-bottom: 12px; }
  .e__foot ul { list-style: none; display: grid; gap: 7px; font-size: 14px; }
