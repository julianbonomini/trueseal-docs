---
// The Human Docs sidebar, drawn from docsNav. A page's children show only while the
// page or one of its children is the current page.
import { docsNav, slugOf } from '../../config/nav';

const currentSlug = slugOf(Astro.url.pathname);
const isCurrent = (slug: string) => slug === currentSlug;
---

<nav class="sidebar" aria-label="Docs">
  {docsNav.map(section => (
    <div class="sidebar__section">
      <p class="sidebar__group">{section.title}</p>
      <ul>
        {section.items.map(item => {
          const expanded = item.children && (isCurrent(item.slug) || item.children.some(c => isCurrent(c.slug)));
          return (
            <li>
              <a href={`/docs/${item.slug}`} aria-current={isCurrent(item.slug) ? 'page' : undefined}>{item.title}</a>
              {expanded && (
                <ul class="sidebar__children">
                  {item.children!.map(child => (
                    <li>
                      <a href={`/docs/${child.slug}`} aria-current={isCurrent(child.slug) ? 'page' : undefined}>{child.title}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>

<style>
  .sidebar__section {
    margin-bottom: 26px;
  }

  .sidebar__group {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    color: var(--ink-muted);
    margin-bottom: 8px;
  }

  .sidebar ul {
    list-style: none;
    display: grid;
    gap: 1px;
  }

  .sidebar__children {
    margin: 1px 0 0 12px;
  }

  .sidebar a {
    display: block;
    font-size: var(--text-ui);
    line-height: 1.45;
    padding: 5px 12px;
    color: var(--ink);
    text-decoration: none;
    border-left: 1px solid var(--rule);
  }

  .sidebar a:hover {
    border-left-color: var(--ink);
  }

  .sidebar a[aria-current] {
    border-left: 2px solid var(--seal);
    padding-left: 11px;
    font-weight: 600;
  }
</style>
