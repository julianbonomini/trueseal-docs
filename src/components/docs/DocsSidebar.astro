---
// A documentation sidebar, for the surface of the current page. nav.ts decides which links
// it holds, which is current and which children show.
import { sidebarOf } from '../../config/nav';

const sidebar = sidebarOf(Astro.url.pathname);
---

{sidebar && (
  <nav class="sidebar" aria-label={sidebar.label}>
    {sidebar.sections.map(section => (
      <div class="sidebar__section">
        <p class="sidebar__group">{section.title}</p>
        <ul>
          {section.links.map(link => (
            <li>
              <a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.title}</a>
              {link.children.length > 0 && (
                <ul class="sidebar__children">
                  {link.children.map(child => (
                    <li>
                      <a href={child.href} aria-current={child.current ? 'page' : undefined}>{child.title}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
)}

<style>
  .sidebar__section {
    margin-bottom: 26px;
  }

  .sidebar__group {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    color: var(--ink-muted);
    margin-bottom: 8px;
  }

  .sidebar ul {
    list-style: none;
    display: grid;
    gap: 1px;
  }

  .sidebar__children {
    margin: 1px 0 0 12px;
  }

  .sidebar a {
    display: block;
    font-size: var(--text-ui);
    line-height: 1.45;
    padding: 5px 12px;
    color: var(--ink);
    text-decoration: none;
    border-left: 1px solid var(--rule);
  }

  .sidebar a:hover {
    border-left-color: var(--ink);
  }

  .sidebar a[aria-current] {
    border-left: 2px solid var(--seal);
    padding-left: 11px;
    font-weight: 600;
  }
</style>
