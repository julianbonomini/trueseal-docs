---
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<div class="badge">{text}</div>

<style>
  .badge {
    display: inline-block;
    align-self: flex-start;
    border: 1px solid var(--ink);
    padding: var(--space-xs) var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-code);
    line-height: 1.6;
    color: var(--ink);
  }
</style>
