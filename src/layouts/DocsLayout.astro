---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

// Auto-generate breadcrumb from pathname
const pathname = Astro.url.pathname;
const segments = pathname
  .replace(/^\/docs\/?/, '')
  .split('/')
  .filter(Boolean);

// Detect right rail — renders 3-col if slot is filled
const hasRightRail = Astro.slots.has('right-rail');
---

<BaseLayout title={title} description={description}>
  <Navbar activeItem="docs" />

  <div class="docs-shell">
    <div class="docs-sidebar-wrapper">
      <DocsSidebar />
    </div>

    <div class="docs-main">
      <div class:list={['docs-inner', { 'docs-inner--with-rail': hasRightRail }]}>

        <!-- Centre column -->
        <div class="docs-content">

          <!-- Breadcrumb -->
          <nav class="docs-breadcrumb">
            <span>DOCS</span>
            {segments.map(seg => (
              <>
                <span class="docs-breadcrumb__sep">/</span>
                <span class="docs-breadcrumb__seg">
                  {seg.replace(/-/g, '\u00a0').toUpperCase()}
                </span>
              </>
            ))}
          </nav>

          <!-- Page content -->
          <article class="prose">
            <slot />
          </article>
        </div>

        <!-- Right rail (optional) -->
        {hasRightRail && (
          <aside class="docs-right-rail">
            <slot name="right-rail" />
          </aside>
        )}

      </div>

      <Footer />
    </div>
  </div>
</BaseLayout>

<style>
  /* ─── Shell ──────────────────────────────────────────── */
  .docs-shell {
    display: flex;
    align-items: flex-start;
  }

  /* Sidebar wrapper — DocsLayout owns flex dimensions */
  .docs-sidebar-wrapper {
    width: 288px;
    flex-shrink: 0;
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow-y: auto;
    z-index: 10;
  }

  /* ─── Main (everything right of sidebar) ────────────── */
  .docs-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* ─── Inner (prose + optional right rail) ───────────── */
  .docs-inner {
    flex: 1;
    display: flex;
    min-height: calc(100vh - 64px);
  }

  /* ─── Centre content column ──────────────────────────── */
  .docs-content {
    flex: 1;
    min-width: 0;
    padding: var(--space-xl) calc(var(--space-xl) * 2);
    max-width: 900px;
  }

  /* When right rail is present, cap prose width */
  .docs-inner--with-rail .docs-content {
    max-width: 900px;
  }

  /* ─── Breadcrumb ─────────────────────────────────────── */
  .docs-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-mono-label-size);
    font-weight: var(--text-mono-label-weight);
    letter-spacing: var(--text-mono-label-tracking);
    color: var(--color-secondary);
    margin-bottom: var(--space-xl);
  }

  .docs-breadcrumb__sep {
    color: var(--color-outline);
  }

  .docs-breadcrumb__seg:last-child {
    color: var(--color-on-surface);
  }

  /* ─── Right rail ─────────────────────────────────────── */
  .docs-right-rail {
    width: 320px;
    flex-shrink: 0;
    border-left: 1px solid var(--color-outline-variant);
    padding: var(--space-xl) var(--space-lg);
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow-y: auto;
    background: var(--color-surface-container-lowest);
  }
</style>
