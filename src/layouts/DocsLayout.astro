---
// A documentation page on either surface: header, a persistent sidebar (a "Menu" disclosure below 900px),
// the page with its section crumb and previous/next links in sidebar order, and an
// "On this page" list of its h2 headings. A Human Docs page also links to its Agent Docs version and
// offers Copy as Markdown, the one Island this layout adds.
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';
import NextPage from '../components/mdx/NextPage.astro';
import CopyMarkdown from '../components/mdx/CopyMarkdown';
import { agentsVersionOf, markdownPathOf, placeOf } from '../config/nav';
import { versionLabel } from '../config/site';

interface Props {
  title: string;
  description?: string;
  headings: MarkdownHeading[];
}

const { title, description, headings } = Astro.props;

const place = placeOf(Astro.url.pathname);
const agentsVersion = agentsVersionOf(Astro.url.pathname);
const toc = headings.filter(h => h.depth === 2);
---

<BaseLayout title={title} description={description}>
  <Navbar />

  <div class="docs">
    <aside class="docs__side">
      <DocsSidebar />
    </aside>

    <main class="docs__main">
      <details class="docs__menu">
        <summary>Menu <span class="docs__menu-version">{versionLabel}</span></summary>
        <DocsSidebar />
      </details>
      {(place || agentsVersion) && (
        <div class="docs__meta" data-pagefind-ignore>
          {place && <p class="docs__crumb">{place.section}</p>}
          {agentsVersion && (
            <div class="docs__versions">
              <a href={agentsVersion.href}>Agent Docs: {agentsVersion.title}</a>
              <CopyMarkdown client:idle href={markdownPathOf(Astro.url.pathname)} />
            </div>
          )}
        </div>
      )}
      <article class="prose">
        <slot />
        {place && <NextPage prev={place.prev} next={place.next} />}
      </article>
    </main>

    {toc.length > 0 && (
      <nav class="docs__toc" aria-label="On this page">
        <p class="docs__toc-title">On this page</p>
        {toc.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}
      </nav>
    )}
  </div>

  <Footer />
</BaseLayout>

<style>
  .docs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
    flex: 1;
  }

  .docs__side {
    display: none;
  }

  .docs__main {
    padding: 48px clamp(16px, 5vw, 72px) 120px;
    max-width: 800px;
    min-width: 0;
  }

  .docs__menu {
    margin-bottom: 24px;
  }

  .docs__menu summary {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    border: 1px solid var(--rule);
    padding: 8px 12px;
    cursor: pointer;
  }

  .docs__menu[open] summary {
    margin-bottom: 24px;
  }

  .docs__menu-version {
    color: var(--ink-muted);
  }

  .docs__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: 16px;
  }

  .docs__crumb {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--ink-muted);
  }

  /* Right-aligned even on a page with no crumb. */
  .docs__versions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
  }

  .docs__toc {
    display: none;
  }

  .docs__toc-title {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 500;
    color: var(--ink-muted);
  }

  .docs__toc a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .docs__toc a:hover {
    color: var(--ink);
  }

  @media (min-width: 900px) {
    .docs {
      grid-template-columns: 260px minmax(0, 1fr);
    }

    .docs__side {
      display: block;
      position: sticky;
      top: var(--header-height);
      height: calc(100vh - var(--header-height));
      overflow-y: auto;
      padding: 28px 24px 96px;
      border-right: 1px solid var(--rule);
    }

    .docs__menu {
      display: none;
    }
  }

  @media (min-width: 1240px) {
    .docs {
      grid-template-columns: 260px minmax(0, 1fr) 240px;
    }

    .docs__toc {
      display: grid;
      gap: 9px;
      align-content: start;
      align-self: start;
      position: sticky;
      top: calc(var(--header-height) + 8px);
      padding: 48px 24px;
      font-size: 13px;
    }
  }
</style>
