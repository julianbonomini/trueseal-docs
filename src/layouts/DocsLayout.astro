---
import BaseLayout from './BaseLayout.astro';
import { docsNav } from '../config/nav';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
---

<BaseLayout title={title} description={description}>
  <div class="docs-layout">
    <aside class="docs-sidebar">
      <a href="/" class="docs-home-link">← hush</a>
      <nav>
        {docsNav.map(section => (
          <div class="nav-section">
            <span class="nav-section-label">{section.title}</span>
            <ul>
              {section.items.map(item => (
                <li>
                  <a
                    href={`/docs/${item.slug}`}
                    class:list={[
                      'nav-link',
                      { 'nav-link--active': currentPath === `/docs/${item.slug}` },
                    ]}
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <main class="docs-content">
      <article class="prose">
        <slot />
      </article>
    </main>
  </div>
</BaseLayout>

<style>
  .docs-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    min-height: 100vh;
  }

  .docs-sidebar {
    border-right: 1px solid var(--color-outline-variant);
    padding: var(--space-lg) var(--space-md);
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
    background: var(--color-surface-container-lowest);
  }

  .docs-home-link {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-mono-label-size);
    color: var(--color-on-surface-variant);
    text-decoration: none;
    margin-bottom: var(--space-lg);
  }

  .nav-section {
    margin-bottom: var(--space-lg);
  }

  .nav-section-label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-mono-label-size);
    font-weight: var(--text-mono-label-weight);
    letter-spacing: var(--text-mono-label-tracking);
    text-transform: uppercase;
    color: var(--color-outline);
    margin-bottom: var(--space-sm);
  }

  ul {
    list-style: none;
  }

  .nav-link {
    display: block;
    font-size: var(--text-body-sm-size);
    color: var(--color-on-surface-variant);
    text-decoration: none;
    padding: var(--space-xs) 0;
    transition: color 0.15s;
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--color-on-surface);
  }

  .docs-content {
    padding: var(--space-xl) var(--space-lg);
    max-width: 720px;
  }
</style>
