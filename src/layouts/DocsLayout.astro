---
import BaseLayout from './BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

// Auto-generate breadcrumb from pathname
const pathname = Astro.url.pathname;
const segments = pathname
  .replace(/^\/docs\/?/, '')
  .split('/')
  .filter(Boolean);

// Detect right rail — renders 3-col if slot is filled
const hasRightRail = Astro.slots.has('right-rail');
---

<BaseLayout title={title} description={description}>
  <Navbar activeItem="docs" />

  <div class="docs-shell" id="docs-shell">
    <div class="docs-sidebar-wrapper">
      <DocsSidebar />
    </div>

    <!-- Mobile backdrop -->
    <div class="docs-backdrop" id="docs-backdrop"></div>

    <div class="docs-main">
      <div class:list={['docs-inner', { 'docs-inner--with-rail': hasRightRail }]}>

        <!-- Centre column -->
        <div class="docs-content">

          <!-- Mobile menu bar -->
          <div class="docs-mobile-bar">
            <button class="docs-menu-btn" id="docs-menu-btn" aria-label="Open navigation">
              <span class="material-symbols-outlined">menu</span>
              MENU
            </button>
          </div>

          <!-- Breadcrumb -->
          <nav class="docs-breadcrumb">
            <span>DOCS</span>
            {segments.map(seg => (
              <>
                <span class="docs-breadcrumb__sep">/</span>
                <span class="docs-breadcrumb__seg">
                  {seg.replace(/-/g, '\u00a0').toUpperCase()}
                </span>
              </>
            ))}
          </nav>

          <!-- Page content -->
          <article class="prose">
            <slot />
          </article>
        </div>

        <!-- Right rail (optional) -->
        {hasRightRail && (
          <aside class="docs-right-rail">
            <slot name="right-rail" />
          </aside>
        )}

      </div>

      <Footer />
    </div>
  </div>
</BaseLayout>

<style>
  /* ─── Shell ──────────────────────────────────────────── */
  .docs-shell {
    display: flex;
    align-items: flex-start;
  }

  /* Sidebar wrapper — DocsLayout owns flex dimensions */
  .docs-sidebar-wrapper {
    width: 288px;
    flex-shrink: 0;
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow-y: auto;
    z-index: 10;
  }

  /* ─── Main (everything right of sidebar) ────────────── */
  .docs-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* ─── Inner (prose + optional right rail) ───────────── */
  .docs-inner {
    flex: 1;
    display: flex;
    min-height: calc(100vh - 64px);
  }

  /* ─── Centre content column ──────────────────────────── */
  .docs-content {
    flex: 1;
    min-width: 0;
    padding: var(--space-xl) calc(var(--space-xl) * 2);
    max-width: 900px;
  }

  /* When right rail is present, cap prose width */
  .docs-inner--with-rail .docs-content {
    max-width: 900px;
  }

  /* ─── Breadcrumb ─────────────────────────────────────── */
  .docs-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-mono-label-size);
    font-weight: var(--text-mono-label-weight);
    letter-spacing: var(--text-mono-label-tracking);
    color: var(--color-secondary);
    margin-bottom: var(--space-xl);
  }

  .docs-breadcrumb__sep {
    color: var(--color-outline);
  }

  .docs-breadcrumb__seg:last-child {
    color: var(--color-on-surface);
  }

  /* ─── Right rail ─────────────────────────────────────── */
  .docs-right-rail {
    width: 320px;
    flex-shrink: 0;
    border-left: 1px solid var(--color-outline-variant);
    padding: var(--space-xl) var(--space-lg);
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow-y: auto;
    background: var(--color-surface-container-lowest);
  }

  /* ─── Mobile ─────────────────────────────────────────── */
  .docs-mobile-bar {
    display: none;
  }

  .docs-backdrop {
    display: none;
  }

  @media (max-width: 767px) {
    .docs-sidebar-wrapper {
      position: fixed;
      left: -288px;
      top: 64px;
      height: calc(100vh - 64px);
      transition: left 0.2s ease;
      z-index: 40;
      border-right: 1px solid var(--color-primary);
    }

    .docs-shell--open .docs-sidebar-wrapper {
      left: 0;
    }

    .docs-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: transparent;
      z-index: 39;
      pointer-events: none;
    }

    .docs-shell--open .docs-backdrop {
      background: rgba(0, 0, 0, 0.4);
      pointer-events: all;
    }

    .docs-mobile-bar {
      display: flex;
      margin-bottom: var(--space-lg);
    }

    .docs-menu-btn {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      font-family: var(--font-mono);
      font-size: var(--text-mono-label-size);
      font-weight: var(--text-mono-label-weight);
      letter-spacing: var(--text-mono-label-tracking);
      color: var(--color-secondary);
      background: transparent;
      border: 1px solid var(--color-outline-variant);
      padding: var(--space-xs) var(--space-md);
      cursor: pointer;
    }

    .docs-menu-btn .material-symbols-outlined {
      font-size: 16px;
    }

    .docs-content {
      padding: var(--space-lg) var(--space-md);
    }
  }
</style>

<script>
  const shell = document.getElementById('docs-shell');
  const btn = document.getElementById('docs-menu-btn');
  const backdrop = document.getElementById('docs-backdrop');

  function open() { shell?.classList.add('docs-shell--open'); }
  function close() { shell?.classList.remove('docs-shell--open'); }

  btn?.addEventListener('click', open);
  backdrop?.addEventListener('click', close);
</script>
