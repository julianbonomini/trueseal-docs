---
// Imported here, not with @import in a <style> block, so Vite bundles the @fontsource font files.
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** False keeps the whole page out of the Pagefind search index. Defaults to true. */
  searchable?: boolean;
}

const {
  title,
  description = 'End-to-end encrypted sync for Swift, Kotlin and TypeScript, with a relay you run yourself.',
  searchable = true,
} = Astro.props;

const fullTitle = title === 'trueseal' ? 'trueseal' : `${title} — trueseal`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://trueseal.dev');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="trueseal" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Theme init: runs before paint to prevent flash -->
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', stored ?? preferred);
    </script>
  </head>
  {/* Once any page carries data-pagefind-body, Pagefind indexes only the pages that carry it.
      That keeps Astro's redirect pages, which have no layout, and the 404 page out of the index. */}
  <body data-pagefind-body={searchable ? '' : undefined}>
    <slot />
  </body>
</html>
