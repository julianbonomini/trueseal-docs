---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Mascot from '../components/ui/Mascot.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist on trueseal.dev." searchable={false}>
  <Navbar />
  <main class="not-found section-display">
    <div class="not-found__mascot"><Mascot /></div>
    <p class="section-display__kicker">404</p>
    <h1 class="section-display__heading">This page doesn't exist.</h1>
    <p class="not-found__lead section-display__lede">The link may be old or mistyped.</p>
    <div class="not-found__actions">
      <Button href="/">Back to the start</Button>
      <Button variant="secondary" href="/docs/overview/what-trueseal-is">Read the docs</Button>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found {
    max-width: var(--layout-max-width);
    width: 100%;
    margin: 0 auto;
    flex: 1;
  }

  .not-found__mascot {
    width: clamp(160px, 30vw, 240px);
    margin-bottom: 40px;
  }

  .not-found__lead {
    margin-top: 24px;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }
</style>
