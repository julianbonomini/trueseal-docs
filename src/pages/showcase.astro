---
import LandingLayout from '../layouts/LandingLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
---

<LandingLayout title="Showcase" description="Apps and projects built on trueseal.">
  <Navbar />
  <main class="placeholder">
    <div class="placeholder__inner">
      <p class="placeholder__label">// SHOWCASE</p>
      <h1 class="placeholder__headline">Coming&nbsp;soon.</h1>
      <p class="placeholder__body">
        Apps built on trueseal will be listed here. First entry: trueseal-clip,
        a cross-device clipboard sync utility for macOS and iOS.
      </p>
    </div>
  </main>
  <Footer />
</LandingLayout>

<style>
  .placeholder {
    width: 100%;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: calc(var(--space-xl) * 3) var(--space-xl);
  }
  .placeholder__inner {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .placeholder__label {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label-size);
    font-weight: var(--text-mono-label-weight);
    letter-spacing: var(--text-mono-label-tracking);
    color: var(--color-secondary);
    margin: 0;
  }
  .placeholder__headline {
    font-family: var(--font-sans);
    font-size: clamp(var(--text-display-size), 5vw, 64px);
    font-weight: var(--text-display-weight);
    line-height: var(--text-display-leading);
    letter-spacing: var(--text-display-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0;
  }
  .placeholder__body {
    font-family: var(--font-sans);
    font-size: var(--text-body-lg-size);
    line-height: var(--text-body-lg-leading);
    color: var(--color-on-surface-variant);
    border-left: 2px solid var(--color-primary);
    padding-left: var(--space-md);
    margin: 0;
  }
</style>
