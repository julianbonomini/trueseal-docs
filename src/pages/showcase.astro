---
import LandingLayout from '../layouts/LandingLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
---

<LandingLayout title="Showcase" description="Apps and projects built on trueseal.">
  <Navbar />
  <main class="placeholder">
    <div class="placeholder__inner">
      <p class="placeholder__label">// SHOWCASE</p>
      <h1 class="placeholder__headline">Coming&nbsp;soon.</h1>
      <p class="placeholder__body">
        Apps built on trueseal will be listed here. First entry: trueseal-clip,
        a cross-device clipboard sync utility for macOS and iOS.
      </p>
    </div>
  </main>
  <Footer />
</LandingLayout>

<style>
  .placeholder {
    width: 100%;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    flex: 1;
    padding: 120px clamp(16px, 5vw, var(--space-xl));
  }
  .placeholder__inner {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .placeholder__label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--ink-muted);
  }
  .placeholder__headline {
    font-size: var(--text-h1);
    font-weight: var(--weight-heading);
    line-height: var(--leading-h1);
    letter-spacing: var(--tracking-h1);
  }
  .placeholder__body {
    color: var(--ink-muted);
    border-left: 2px solid var(--ink);
    padding-left: var(--space-md);
  }
</style>
