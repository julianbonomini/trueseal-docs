---
import LandingLayout from '../layouts/LandingLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import Button from '../components/ui/Button.astro';

// Pre-launch placeholder values. Swap these two strings when the relay deploys.
const RELAY_URL = 'tcp://relay.trueseal.dev';
const RELAY_PUBKEY_HEX = '3f783127c25c91ac8ea02ab97edca78e5708e0c686fa0cc2e714c135c7cd095e';

// Group the hex into 4-char blocks for readability (8 + 8 = 16 groups of 4).
const hexGroups: string[] = [];
for (let i = 0; i < RELAY_PUBKEY_HEX.length; i += 4) {
  hexGroups.push(RELAY_PUBKEY_HEX.slice(i, i + 4));
}
const hexLine1 = hexGroups.slice(0, 8).join(' ');
const hexLine2 = hexGroups.slice(8).join(' ');
---

<LandingLayout title="Public Relay" description="The trueseal public hosted relay — endpoint URL, public identity key, and how to point clients at it.">
  <Navbar />
  <main class="relay">
    <div class="relay__inner">

      <!-- Header -->
      <header class="relay__header">
        <StatusBadge text="// PUBLIC RELAY" />
        <h1 class="relay__headline">Private by default,<br />not by promise.</h1>
        <p class="relay__sub">Free, anonymous. For prototyping and low-stakes apps.</p>
      </header>

      <hr class="relay__hr" />

      <!-- Identity block: QR + values -->
      <section class="relay__identity">
        <!-- QR side -->
        <div class="relay__qr-side">
          <div class="relay__qr-wrap">
            <div class="relay__qr-frame">
              <img class="relay__qr-img" src="/assets/relay-qr.svg" alt="QR code encoding the trueseal public relay endpoint and identity key" />
            </div>
          </div>
          <div class="relay__qr-label">RELAY_IDENTITY_QR</div>
        </div>

        <!-- Values side -->
        <div class="relay__values">
          <div class="relay__value-row">
            <div class="relay__value-label">RELAY ENDPOINT</div>
            <div class="relay__value-block">
              <code class="relay__value-text" id="relay-url">{RELAY_URL}</code>
              <button class="relay__copy" type="button" data-copy-target="relay-url" aria-label="Copy relay endpoint">
                <span class="material-symbols-outlined">content_copy</span>
              </button>
            </div>
          </div>

          <div class="relay__value-row">
            <div class="relay__value-label">PUBLIC IDENTITY KEY (HEX)</div>
            <div class="relay__value-block relay__value-block--mono">
              <code class="relay__value-text relay__value-hex" id="relay-pubkey" data-copy-value={RELAY_PUBKEY_HEX}>
                {hexLine1}<br />{hexLine2}
              </code>
              <button class="relay__copy relay__copy--labelled" type="button" data-copy-target="relay-pubkey" aria-label="Copy public identity key">
                <span class="material-symbols-outlined">content_copy</span>
                COPY_HEX_KEY
              </button>
            </div>
          </div>
        </div>
      </section>

      <hr class="relay__hr" />

      <!-- Footer prose + CTAs -->
      <section class="relay__footer">
        <div class="relay__prose">
          <p>
            This is for prototyping and low-stakes apps. Production deployments should
            <strong>self-host</strong> to keep sovereign control over message persistence and throughput.
          </p>
          <p>
            The security model is <em>identical</em> regardless of who runs the relay — the relay receives
            ciphertext addressed to public keys and never holds the keys to decrypt it.
          </p>
          <p>
            <a class="relay__loglink" href="https://github.com/julianbonomini/trueseal-relay" target="_blank" rel="noopener">
              Logs are public →
            </a>
            The relay's connection log is published in the open. Recipient public keys and connection
            timestamps only — never content, never sender identity.
          </p>
        </div>

        <div class="relay__cta">
          <Button href="/docs/components/trueseal-relay/deploying" variant="secondary" icon="arrow_forward">
            Deploy your own
          </Button>
        </div>
      </section>

    </div>
  </main>
  <Footer />
</LandingLayout>

<script>
  // Copy-to-clipboard. Each button has data-copy-target pointing at an element id.
  // If that element has data-copy-value, copy that; otherwise copy textContent.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-copy-target');
      if (!id) return;
      const el = document.getElementById(id);
      if (!el) return;
      const value = el.getAttribute('data-copy-value') ?? el.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(value);
        const original = btn.innerHTML;
        btn.innerHTML = '<span class="material-symbols-outlined">check</span>' +
          (btn.classList.contains('relay__copy--labelled') ? ' COPIED' : '');
        setTimeout(() => { btn.innerHTML = original; }, 1500);
      } catch (e) {
        console.warn('clipboard write failed', e);
      }
    });
  });
</script>

<style>
  .relay {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .relay__inner {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: calc(var(--space-xl) * 2) var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    width: 100%;
  }

  /* Header */
  .relay__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 720px;
  }

  .relay__headline {
    font-family: var(--font-sans);
    font-size: clamp(36px, 4.5vw, 56px);
    font-weight: var(--text-display-weight);
    line-height: var(--text-display-leading);
    letter-spacing: var(--text-display-tracking);
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin: 0;
  }

  .relay__sub {
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.6vw, 22px);
    line-height: 1.5;
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  /* Horizontal rule */
  .relay__hr {
    border: 0;
    border-top: 1px solid var(--color-outline-variant);
    margin: 0;
  }

  /* Identity block */
  .relay__identity {
    border: 1px solid var(--color-outline-variant);
    display: grid;
    grid-template-columns: 1fr;
    background: var(--color-surface);
  }

  @media (min-width: 768px) {
    .relay__identity {
      grid-template-columns: 320px 1fr;
    }
  }

  /* QR side */
  .relay__qr-side {
    border-bottom: 1px solid var(--color-outline-variant);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    background: var(--color-surface-container-lowest);
    position: relative;
  }

  @media (min-width: 768px) {
    .relay__qr-side {
      border-bottom: none;
      border-right: 1px solid var(--color-outline-variant);
    }
  }

  .relay__qr-wrap {
    position: relative;
  }

  .relay__pending {
    position: absolute;
    top: -10px;
    left: 8px;
    z-index: 1;
    background: var(--color-on-surface);
    color: var(--color-surface);
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-mono-label-size);
    font-weight: var(--text-mono-label-weight);
    letter-spacing: var(--text-mono-label-tracking);
  }

  .relay__qr-frame {
    background: #fff;
    padding: var(--space-md);
    border: 1px solid var(--color-outline-variant);
    width: 220px;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .relay__qr-img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .relay__qr-label {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label-size);
    font-weight: var(--text-mono-label-weight);
    letter-spacing: var(--text-mono-label-tracking);
    color: var(--color-secondary);
    margin-top: auto;
  }

  /* Values side */
  .relay__values {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .relay__value-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .relay__value-label {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label-size);
    font-weight: var(--text-mono-label-weight);
    letter-spacing: var(--text-mono-label-tracking);
    color: var(--color-secondary);
  }

  .relay__value-block {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--color-surface-container-lowest);
    border: 1px solid var(--color-outline-variant);
    min-width: 0;
  }

  .relay__value-block--mono {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-md);
  }

  .relay__value-text {
    font-family: var(--font-mono);
    font-size: clamp(13px, 1.1vw, 15px);
    color: var(--color-on-surface);
    word-break: break-all;
    flex: 1;
    min-width: 0;
  }

  .relay__value-hex {
    line-height: 1.7;
    letter-spacing: 0.04em;
  }

  .relay__copy {
    background: transparent;
    border: 0;
    color: var(--color-secondary);
    cursor: pointer;
    padding: var(--space-xs);
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-mono-label-size);
    font-weight: var(--text-mono-label-weight);
    letter-spacing: var(--text-mono-label-tracking);
    transition: color 0.1s;
  }

  .relay__copy:hover {
    color: var(--color-primary);
  }

  .relay__copy .material-symbols-outlined {
    font-size: 16px;
  }

  .relay__copy--labelled {
    align-self: flex-end;
  }

  /* Footer */
  .relay__footer {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 768px) {
    .relay__footer {
      grid-template-columns: 1fr auto;
    }
  }

  .relay__prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    color: var(--color-on-surface-variant);
    font-family: var(--font-sans);
    font-size: var(--text-body-md-size);
    line-height: var(--text-body-md-leading);
    max-width: 600px;
  }

  .relay__prose p {
    margin: 0;
  }

  .relay__prose strong {
    color: var(--color-on-surface);
    font-weight: 600;
  }

  .relay__loglink {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid var(--color-primary);
    padding-bottom: 1px;
  }

  .relay__loglink:hover {
    background: var(--color-surface-container-low);
  }

  .relay__cta {
    align-self: end;
  }

  @media (min-width: 768px) {
    .relay__cta {
      align-self: center;
    }
  }
</style>
